PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=librava_db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/librava_db?schema=public"

# JWT Configuration
# Generate a random value with at least 32 characters.
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

